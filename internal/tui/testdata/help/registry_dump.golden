== dashboard — Dashboard page
[navigation] up/k	up
[navigation] down/j	down
[navigation] pgup	page up
[navigation] pgdown	page down
[navigation] home	top
[navigation] end	bottom
[page actions] enter	run action
[page actions] D	disconnect
[page actions] t	stress run
[error modal] enter	ok / close
[error modal] esc	close
[error modal] j/k	scroll one line
[error modal] pgup/pgdown	scroll ten lines
[global] 1-8	pages
[global] :/ctrl+p	palette
[global] c	connect
[global] tab/shift+tab	focus pane
[global] f9	toggle mouse / text selection
[global] ?	this
[global] q	quit / back
[global] ctrl+c	graceful quit

