{
  "args": [
    "connect",
    "check",
    "--host",
    "127.0.0.1",
    "--port",
    "1",
    "--json"
  ],
  "expect_stdout_mode": "json_keys",
  "expect_stdout": [
    "target",
    "reachable",
    "latency_ms",
    "error"
  ],
  "expect_json_fields": {
    "reachable": "false",
    "target": "\"127.0.0.1:1\""
  },
  "expect_stderr_empty": true,
  "expect_exit": 1
}
