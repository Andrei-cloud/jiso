{
  "args": [
    "analyze",
    "analyze.pcap",
    "--yes",
    "--mode",
    "scenario",
    "--json",
    "--spec",
    "spec.json",
    "--header",
    "ascii4"
  ],
  "expect_stdout_mode": "json_keys",
  "expect_stdout": [
    "mode",
    "scenario_name",
    "pair_count",
    "pairs",
    "scenario_step_count",
    "generated_transaction_names",
    "output_file"
  ],
