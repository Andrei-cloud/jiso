{
  "args": [
    "db",
    "stats",
    "--db",
    "session.db",
    "--json"
  ],
  "expect_stdout_mode": "json_keys",
  "expect_stdout": [
    "db_path",
    "size_bytes",
    "session_count",
    "total_transactions",
    "first_session_start",
    "last_session_active"
